{
  config,
  lib,
  pkgs,
  ...
}:
let
  fonts = config.stylix.fonts;
  versions = [
    "3.0"
    "4.0"
  ];
  cssImport = ''@import url("noctalia.css");'';
in
{
  # Preserve typography, icons and cursor configuration, but stop generating
  # fixed colors, a managed gtk-theme preference and the old Flatpak theme pin.
  stylix.targets.gtk.enable = false;
  home.packages = [ pkgs.adw-gtk3 ];
  gtk = {
    enable = true;
    cursorTheme = {
      inherit (config.stylix.cursor) name package size;
    };
    font = {
      inherit (fonts.sansSerif) name package;
      size = fonts.sizes.applications;
    };
    # The built-in hook selects adw-gtk3/adw-gtk3-dark through dconf. Do not
    # put a fixed gtk-theme-name in settings.ini or a competing dconf key.
    theme = null;
    gtk3.extraCss = cssImport;
    gtk4.extraCss = cssImport;
  };

  programs.noctalia.settings.theme.templates.builtin_ids = [
    "gtk3"
    "gtk4"
  ];

  # Both outputs must exist before either built-in apply hook runs. A CSS
  # comment is valid until Noctalia renders the selected palette. These files
  # remain writable runtime outputs; only their import entrypoints are managed.
  home.activation.prepareGtkNoctaliaThemes =
    lib.hm.dag.entryBetween [ "linkGeneration" ] [ "writeBoundary" ]
      (
        lib.concatMapStringsSep "\n" (version: ''
          $DRY_RUN_CMD ${pkgs.python3}/bin/python3 ${./prepare_theme_output.py} \
            ${lib.escapeShellArg "${config.xdg.configHome}/gtk-${version}/noctalia.css"} \
            ${lib.escapeShellArg "${config.xdg.stateHome}/noctalia/gtk-${version}.pre-template.css"} \
            --placeholder '/* Runtime colors are generated by Noctalia. */'
        '') versions
      );
}
