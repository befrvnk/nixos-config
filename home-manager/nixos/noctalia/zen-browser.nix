{
  config,
  inputs,
  lib,
  ...
}:
let
  runtime = "${config.xdg.stateHome}/noctalia/zen-browser";
  styles = [
    "userChrome"
    "userContent"
  ];
in
{
  # Only the stylesheet preference is required. Do not enable privileged
  # developer tools or rewrite user.js across every discovered browser profile.
  programs.zen-browser.policies.Preferences."toolkit.legacyUserProfileCustomizations.stylesheets" = {
    Value = true;
    Status = "locked";
  };

  # Keep imports/profile ownership declarative. The upstream hook writes through
  # symlinks, including store targets, and also visits obsolete/backup profiles.
  home.file = {
    ".zen/default/chrome/userChrome.css".text = ''
      @import url("file://${runtime}/zen-userChrome.css");
    '';
    ".zen/default/chrome/userContent.css".text = ''
      @import url("file://${runtime}/zen-userContent.css");
      ${builtins.readFile ../zen-browser/newtab-layout.css}
    '';
  };

  # Render upstream styles verbatim, with no profile-mutating apply hook. State
  # rather than cache keeps these imported files available after cache cleanup.
  programs.noctalia.settings.theme.templates.user = lib.genAttrs' styles (style: {
    name = "zen_browser_${if style == "userChrome" then "chrome" else "content"}";
    value = {
      input_path = "${inputs.noctalia-community-templates}/zen-browser/zen-${style}.css";
      output_path = "$XDG_STATE_HOME/noctalia/zen-browser/zen-${style}.css";
    };
  });

  noctalia.prepareOutputs = map (style: {
    theme = "${runtime}/zen-${style}.css";
    backup = "${config.xdg.stateHome}/noctalia/zen-${style}.pre-template.css";
    placeholder = "/* Runtime colors are generated by Noctalia. */";
  }) styles;
}
