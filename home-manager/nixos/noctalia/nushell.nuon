  date: "{{colors.terminal_normal_magenta.default.hex}}"
  filesize: "{{colors.terminal_normal_blue.default.hex}}"
  row_index: "{{colors.terminal_normal_cyan.default.hex}}"
  bool: "{{colors.terminal_normal_red.default.hex}}"
  int: "{{colors.terminal_normal_green.default.hex}}"
  duration: "{{colors.terminal_normal_red.default.hex}}"
  range: "{{colors.terminal_normal_red.default.hex}}"
  float: "{{colors.terminal_normal_red.default.hex}}"
  string: "{{colors.terminal_foreground.default.hex}}"
  nothing: "{{colors.terminal_normal_red.default.hex}}"
  binary: "{{colors.terminal_normal_red.default.hex}}"
  cellpath: "{{colors.terminal_normal_red.default.hex}}"
  hints: "{{colors.on_surface_variant.default.hex}}"
  shape_garbage: {fg: "{{colors.terminal_bright_white.default.hex}}", bg: "{{colors.terminal_normal_red.default.hex}}"}
  shape_bool: "{{colors.terminal_normal_blue.default.hex}}"
  shape_int: {fg: "{{colors.terminal_normal_magenta.default.hex}}", attr: b}
