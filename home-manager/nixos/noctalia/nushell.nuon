  shape_range: {fg: "{{colors.terminal_normal_yellow.default.hex}}", attr: b}
  shape_internalcall: {fg: "{{colors.terminal_normal_cyan.default.hex}}", attr: b}
  shape_external: "{{colors.terminal_normal_cyan.default.hex}}"
  shape_externalarg: {fg: "{{colors.terminal_normal_green.default.hex}}", attr: b}
  shape_literal: "{{colors.terminal_normal_blue.default.hex}}"
  shape_operator: "{{colors.terminal_normal_yellow.default.hex}}"
  shape_signature: {fg: "{{colors.terminal_normal_green.default.hex}}", attr: b}
  shape_string: "{{colors.terminal_normal_green.default.hex}}"
  shape_filepath: "{{colors.terminal_normal_blue.default.hex}}"
  shape_globpattern: {fg: "{{colors.terminal_normal_blue.default.hex}}", attr: b}
  shape_variable: "{{colors.terminal_normal_magenta.default.hex}}"
  shape_flag: {fg: "{{colors.terminal_normal_blue.default.hex}}", attr: b}
  shape_custom: {attr: b}
}
