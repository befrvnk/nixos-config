+// Fixed background_fill when set, otherwise the themed surface role; both scaled by background_opacity.
+[[nodiscard]] Color barBackgroundFillColor(const BarConfig& cfg) noexcept {
+  Color fill = cfg.backgroundFill ? resolveColorSpec(*cfg.backgroundFill)
+                                  : colorForRole(ColorRole::Surface);
+  fill.a *= cfg.backgroundOpacity;
+  return fill;
+}
